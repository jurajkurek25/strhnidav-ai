# Verejná URL aplikácie (pre Stripe redirecty)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Hlasový model pre Live API (napr. novší Gemini 3.1 Flash Live, ak ho máš dostupný)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Textový model na vyhodnotenie rozhovoru
GEMINI_EVAL_MODEL=gemini-2.5-flash

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Cena predplatného 49 € / mesiac (Product catalog → Price ID)
STRIPE_PRICE_SUBSCRIPTION=price_...
# true = Stripe Tax počíta DPH (treba mať zapnuté v Stripe)
STRIPE_AUTOMATIC_TAX=false
