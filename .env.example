# Port appky na serveri – rovnaký ako App Port v CloudPanel
PORT=3000

# Verejná URL aplikácie (pre Stripe redirecty)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Na produkcii: NEXT_PUBLIC_APP_URL=https://ai.strhnidav.sk

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Hlasový model pre Live API (pri zmene uprav ceny v src/lib/gemini.ts)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Textový model na vyhodnotenie rozhovoru
GEMINI_EVAL_MODEL=gemini-2.5-flash

# E-maily s prístupom do /admin (oddelené čiarkou)
ADMIN_EMAILS=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Cena predplatného 49 € / mesiac (Product catalog → Price ID)
STRIPE_PRICE_SUBSCRIPTION=price_...
# true = Stripe Tax počíta DPH (treba mať zapnuté v Stripe)
STRIPE_AUTOMATIC_TAX=false
